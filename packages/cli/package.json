{
  "name": "@funnest/script-cli",
  "version": "0.1.1",
  "description": "Funnest Script from the terminal: type-check and test-run scripts, run them on real exchange bars, backtest strategies, read the docs",
  "keywords": [
    "trading",
    "indicator",
    "backtest",
    "cli",
    "ai",
    "funnest"
  ],
  "license": "Apache-2.0",
  "author": "Funnest",
  "homepage": "https://github.com/funnest-xyz/funnest-script/tree/main/packages/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/funnest-xyz/funnest-script.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/funnest-xyz/funnest-script/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "funnest-script": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "funnest-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@funnest/script": "workspace:*",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
